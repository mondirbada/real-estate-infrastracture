{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassProjectRolesToLambdaAndRdsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/real-estate-prod-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    }
  ]
}
