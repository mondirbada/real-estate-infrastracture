{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptSecretsWithCustomerManagedKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "<SECRETS_KMS_KEY_ARN>",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.eu-south-1.amazonaws.com"
        }
      }
    }
  ]
}
